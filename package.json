{
  "name": "el-encanto-campestre-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo para la aplicacion movil, backend API y web de El Encanto Campestre",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.7.3"
  }
}
